---
import Base from '../layouts/Base.astro';
const title = 'Privacy Policy | Smart Accounting Solutions';
const description = 'How Smart Accounting Solutions collects, uses and protects your personal data.';
---
<Base title={title} description={description} noindex={true}>
  <section class="section">
    <div class="container container--narrow">
      <h1 class="h2">Privacy Policy</h1>
      <hr class="gold-divider" />
      <p class="lead">
        This page is awaiting approved copy from the client. It must name every data
        processor the live site uses (analytics, ad platforms, CRM), the lawful basis,
        retention, and the user's rights including the right to complain to the ICO
        (playbook §7). The cookie table will be generated from the consent registry.
      </p>
    </div>
  </section>
</Base>
