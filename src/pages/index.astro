---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SoftwareStrip from '../components/SoftwareStrip.astro';
import CurveSeam from '../components/CurveSeam.astro';
import BrandMark from '../components/BrandMark.astro';
import Faq from '../components/Faq.astro';
import type { FaqItem } from '../components/Faq.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { siteUrl } from '../data/site';

import plumberBookkeepingClient from '../assets/images/plumber-bookkeeping-client.png';
import cafeBookkeepingClient from '../assets/images/cafe-bookkeeping-client.png';
import theAdvisoryMoment from '../assets/images/the-advisory-moment.png';
import craig from '../assets/images/craig-normington.webp';

// SEO metadata to playbook §4 (design meta was not client-approved). Homepage title
// omits the brand — Google auto-appends the site name for homepage results.
const title = 'Small Business Accountant in Penistone & Yorkshire';
const description = 'Bookkeeping, VAT, payroll, accounts and tax for small businesses across Yorkshire. A proactive accountant who shows up all year. Book a free chat.';

// Off until we have real client testimonials to show — section markup/style below is preserved as-is.
const showTestimonials = false;

const faqs: FaqItem[] = [
  { q: 'What does your bookkeeper do for you?', a: 'A bookkeeper records and categorises all your business transactions - income, expenses, bank movements - on a regular basis. They reconcile your bank accounts, prepare VAT returns, keep your records compliant, and ensure your figures are accurate and up to date. Your bookkeeper keeps your finances current throughout the year.' },
  { q: "What's the difference between a bookkeeper and an accountant?", a: 'A bookkeeper handles the day-to-day maintenance of your financial records - categorising transactions, reconciling accounts, filing VAT returns, and keeping everything current. An accountant typically works at a higher level: preparing statutory year-end accounts, filing corporation tax or self-assessment returns, and providing business and accountancy advice.' },
  { q: 'How do I know if my business is actually profitable?', a: 'Turnover, or the balance in your bank account, does not tell you whether your business is profitable. You need accurate, up-to-date income and expenditure figures, broken down clearly so you can see what your business is actually making. Producing management accounts monthly or quarterly gives you that picture on an ongoing basis.' },
  { q: 'What makes Smart Accounting Solutions different from other accountants?', a: 'We get involved in your business throughout the year and become part of your team. Craig remains personally involved and always available when you need him. You will also have a dedicated bookkeeper who gets to know you and your business. We believe in building personal relationships with our clients so we can really understand you and your business. We personalise our service to each client, giving you the help and support you need. We keep your figures up to date, meet with you regularly and help you understand what the numbers actually mean for your business. It is all built around giving you useful information, practical help and someone to talk to whenever you need it.' },
  { q: 'How do I get started with Smart Accounting Solutions?', a: 'The first step is a conversation with Craig. Get in touch by phone on 0114 349 3311, email hello@smartaccountingsolutions.co.uk, or through the website contact form. Craig will listen to where you are, discuss what you need and explain how we can help. No hard sell, no fixed agenda.' },
  { q: 'My accountant only contacts me once a year at year end. Is that normal?', a: "It's common for traditional accountants, but it's not good enough for most businesses. Annual accounts are filed months after the year end and reflect historical decisions. You need financial information while it is still useful, which means regular, up-to-date information, not an annual review when the figures are already out of date. If your accountant only engages at year end, the value they are adding is largely compliance, not ongoing business support." },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteUrl}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description} active="home" schema={[faqSchema]}>
  <Hero size="home">
    <h1 class="hero-h1 hero-h1--home home-h1">You run the business. We handle the numbers.</h1>
    <p class="hero-lead">
      Smart Accounting Solutions handles your bookkeeping, VAT, accounts, payroll and tax,
      then sits down with you to make sense of the numbers. You get a clear picture of where
      your business stands and have someone alongside you when decisions need to be made.
    </p>
    <p class="hero-note">Fixed monthly fee, with unlimited support by phone, email and face to face included. You are never charged extra for picking up the phone.</p>
    <div class="hero-actions">
      <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
      <a href={site.phoneOfficeHref} class="btn btn--outline">Call {site.phoneOffice}</a>
    </div>
    <p slot="band" class="hero-strip">Bookkeeping&nbsp;&nbsp;·&nbsp;&nbsp;VAT&nbsp;&nbsp;·&nbsp;&nbsp;Payroll&nbsp;&nbsp;·&nbsp;&nbsp;Accounts&nbsp;&nbsp;·&nbsp;&nbsp;Tax</p>
  </Hero>

  <SoftwareStrip />

  <!-- Sound familiar? -->
  <section aria-label="Sound familiar">
    <div class="container two-col two-col--start pad-lg">
      <div>
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="h2 h2--md">Running a business is hard enough without feeling like you're doing it alone.</h2>
        <p class="body mt-28">Most small business owners started out to do one thing well. At some point, the admin, the tax obligations and the financial uncertainty crept in alongside it. Now there is always something nagging in the background.</p>
        <p class="body body--strong mt-32">Does this sound like you?</p>
        <ul class="pain-list">
          <li><span class="tri" aria-hidden="true"></span><span>I am never quite sure where I stand with the numbers</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>I do not always know where to turn when I need advice</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>I do not have a team around me, and it can feel like a lonely struggle</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>I worry about missing something important, like a deadline</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>I cannot get hold of my accountant when I need them</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>The amount of admin often feels overwhelming and pulls me away from doing what I am best at.</span></li>
        </ul>
      </div>
      <Image src={plumberBookkeepingClient} alt="A plumber client of Smart Accounting Solutions working under a kitchen sink" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 560px" class="photo photo--cover" />
    </div>
  </section>

  <!-- It is not your fault -->
  <section aria-label="It is not your fault" class="band-brand">
    <CurveSeam fill="#ffffff" />
    <BrandMark size="min(64vw, 640px)" color="#ffffff" opacity={0.05} top="4%" right="-8%" rotate="-6deg" />
    <div class="container container--880 pad-lg">
      <p class="statement">It is not your fault.</p>
      <p class="band-lead">You did not go into business to become an expert in bookkeeping, tax codes and quarterly filings. That is our job, not yours. What you deserve is numbers that are up to date while they still mean something, and someone who sits down with you to explain what they show and what to do next. That is the standard we hold ourselves to.</p>
      <p class="band-sub">Your business is always changing, and so is everything around it, from costs to tax rules. With your figures kept up to date all year round, we can give you the information and advice to make good decisions as things change, not months after the moment has passed.</p>
      <hr class="gold-divider gold-divider--wide" />
      <p class="band-punch">You deserve better than an accountant who only shows up once a year.</p>
      <a href={site.bookingUrl} class="btn btn--gold mt-44">Book a free chat</a>
    </div>
  </section>

  <!-- A different kind of service -->
  <section aria-label="A different kind of service">
    <CurveSeam fill="#ffffff" variant="up" />
    <div class="container two-col two-col--center pad-lg">
      <Image src={cafeBookkeepingClient} alt="A cafe owner client of Smart Accounting Solutions serving behind the counter" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 560px" class="photo photo--cover order-first" />
      <div>
        <p class="eyebrow">A different kind of service</p>
        <h2 class="h2 h2--sm">We do not just process your numbers. We help you understand them, throughout the year, when it still matters.</h2>
        <p class="body body--strong mt-28">Built for businesses like yours.</p>
        <p class="body mt-18">Smart Accounting Solutions was built differently, around the needs of people responsible for running their own businesses. The sole traders. The limited company directors. The landlords navigating Making Tax Digital. We handle everything from the basics up, from bookkeeping, VAT and payroll through to management accounts, year-end accounts and tax returns. Then we sit down with you, go through the figures, and tell you what they mean for your business right now, not in 18 months' time when the opportunity to act has passed.</p>
        <p class="body body--strong mt-32">Already have a bookkeeper or do the bookkeeping yourself?</p>
        <p class="body mt-18">You may already have a bookkeeper who needs some help. We can work alongside them, train them and provide support where needed. You may be doing the bookkeeping yourself, in which case we can support you too. Either way, we're here to help you get the most from your software, get the information you need and understand what it means for your business.</p>
        <p class="pull-quote">One phone call, one WhatsApp message. You will always get through to someone who knows you, and it is all included in your fixed monthly fee.</p>
        <p class="body body--strong mt-28">Fixed monthly fees. Unlimited support. Dedicated people who know your business, your bookkeeper and Craig.</p>
      </div>
    </div>
  </section>

  <!-- Meet Craig -->
  <section aria-label="Meet Craig" class="band-subtle">
    <CurveSeam fill="#ffffff" />
    <div class="container two-col two-col--center pad-lg">
      <div>
        <p class="eyebrow">Who you'll be working with</p>
        <h2 class="h2 h2--lg">Meet Craig</h2>
        <p class="body mt-28">My name is Craig Normington. I have over 25 years of experience working directly with business owners across Yorkshire and beyond.</p>
        <p class="body mt-18">I set up Smart Accounting Solutions because I wanted to create a service that really understands your business. One where we sit down regularly, go through the numbers, help you understand what they mean, discuss what's happening in the business and what to do next.</p>
        <p class="body mt-18">Every client I take on, I stay involved with personally. You will not be handed off. You will deal with me and your dedicated bookkeeper, and we will both get to know you and your business.</p>
        <div class="stats">
          <div class="stat"><p class="stat-fig">25+</p><p class="stat-label">Years working directly with business owners</p></div>
          <div class="stat"><p class="stat-fig">One</p><p class="stat-label">Point of contact for your accounts and advice</p></div>
          <div class="stat"><p class="stat-fig">Yorkshire</p><p class="stat-label">Serving businesses across the region</p></div>
        </div>
        <a href="/about/" class="text-link">Find out more about Craig
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M1 6H15M15 6L10.5 1.5M15 6L10.5 10.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
      <Image src={craig} alt="Craig Normington, Director of Smart Accounting Solutions, bookkeeper and accountant serving small businesses across Yorkshire" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 460px" class="img-circle" />
    </div>
  </section>

  <!-- What you get -->
  <section aria-label="What you get">
    <CurveSeam fill="#f7f5f9" />
    <div class="container pad-lg">
      <h2 class="h2 h2--wide">Every client gets</h2>
      <div class="get-rows">
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>Your dedicated bookkeeper.</h3>
          <p class="body">You will always deal with the same person. They will learn how you work, what your business needs, and how to make your life easier. No starting from scratch every month.</p>
        </div>
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>Craig, always on hand</h3>
          <p class="body">Your bookkeeper handles the day-to-day. But Craig is always one call away if something comes up. Finances, concerns, plans for the future, whatever it is, just ask.</p>
        </div>
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>A fixed fee, agreed up front</h3>
          <p class="body">You know exactly what you are paying from the start. One fixed monthly fee, no hidden costs, and no charge every time you call, email or need a meeting. It's all included.</p>
        </div>
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>Real meetings, not just reports</h3>
          <p class="body">We believe in sitting down together, whether that is at your place or ours or on a Zoom or Teams call. We go through the numbers and make sure you actually understand them. That is how good decisions get made.</p>
        </div>
        <div class="get-row get-row--last">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>A regular business review</h3>
          <p class="body">At least every six months, we will catch up to talk through your business and your plans, even when nothing is wrong. Staying close is how we spot opportunities and head off problems early.</p>
        </div>
      </div>
      <Image src={theAdvisoryMoment} alt="Craig going through a set of figures with a client at a desk" widths={[600, 900, 1200]} sizes="(max-width: 1200px) 100vw, 1152px" class="photo photo--wide" />
    </div>
  </section>

  <!-- MTD for Income Tax -->
  <section aria-label="MTD for Income Tax" class="band-lilac">
    <CurveSeam fill="#ffffff" />
    <div class="container two-col two-col--start pad-lg">
      <div>
        <p class="eyebrow">MTD for Income Tax is here.</p>
        <h2 class="h2 h2--md2">Do you know what to do?</h2>
        <p class="body mt-28">As of April 2026, sole traders and landlords with more than £50,000 of qualifying income must keep digital records and submit quarterly updates to HMRC under Making Tax Digital for Income Tax (MTD for ITSA).</p>
        <p class="body mt-18">Need help with MTD, or want us to take care of it for you? We will run through the process with you, get you on the right software, set everything up correctly and make sure your quarterly updates are filed accurately and on time.</p>
        <p class="body mt-18">Already behind? Don't worry. Get in touch and we'll help you get up to date.</p>
        <p class="body mt-18">And if your income is currently below £50,000, do not wait. The threshold drops to £30,000 in April 2027 and £20,000 in April 2028. Getting set up properly now is far easier than scrambling later.</p>
        <a href={site.bookingUrl} class="btn btn--purple btn--sm mt-36">Talk to Craig about MTD for ITSA</a>
      </div>
      <div class="mtd-card">
        <p class="mtd-card-label">The MTD timeline</p>
        <ol class="timeline">
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot tl-dot--filled"></span><span class="tl-line"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2026</p>
              <p class="tl-fig">Over £50,000</p>
              <p class="tl-note">Digital records and quarterly HMRC updates are now mandatory. This is already in force.</p>
            </div>
          </li>
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot"></span><span class="tl-line"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2027</p>
              <p class="tl-fig">Over £30,000</p>
              <p class="tl-note">The threshold drops. Many more sole traders and landlords come into scope.</p>
            </div>
          </li>
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2028</p>
              <p class="tl-fig">Over £20,000</p>
              <p class="tl-note">The threshold drops again. Getting set up early means less pressure when yours arrives.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section aria-label="Who this is for">
    <CurveSeam fill="#f4eff9" />
    <div class="container container--1040 pad-lg">
      <p class="eyebrow">Who this is for</p>
      <h2 class="h2 h2--md3">You might be exactly who we work best with.</h2>
      <p class="body body--strong mt-28">We work with:</p>
      <ul class="check-list">
        {[
          'Business owners looking for a more proactive accountant',
          'Business owners who want more than a once-a-year tax conversation',
          'Businesses looking for proper financial oversight',
          'Those who have outgrown their bookkeeping setup or want to improve it',
          'Sole traders and landlords getting to grips with Making Tax Digital (MTD for ITSA)',
          'New businesses that want to get set up properly from day one',
        ].map((t) => (
          <li>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="var(--sas-gold)"></circle><path d="M6.5 11.5L9.5 14.5L15.5 8" stroke="#36184f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      <div class="who-cta">
        <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
        <p class="body who-cta-note">If you want an accountant who is actually going to get involved in your business, we should talk.</p>
      </div>
    </div>
  </section>

  {showTestimonials && (
    <section aria-label="What clients say" class="band-subtle">
      <CurveSeam fill="#ffffff" />
      <div class="container container--800 pad-md center">
        <h2 class="h2 h2--sm2">What clients say</h2>
        <div class="stars" aria-label="Five stars">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.8L10 14.8l-5.3 2.8 1.1-5.8L1.5 7.7l5.9-.8Z" fill="var(--sas-gold)"></path></svg>
          ))}
        </div>
        <blockquote class="quote">
          <p class="quote-text">"Before Craig, I had no idea how my business was actually performing. Now I come out of every meeting with a clear picture and a list of things to go and do."</p>
          <footer class="quote-cite">Client name, business type, location</footer>
        </blockquote>
      </div>
    </section>
  )}

  <!-- Ready to start -->
  <section aria-label="Ready to start" class="band-brand">
    <CurveSeam fill="#f7f5f9" />
    <BrandMark size="min(60vw, 620px)" color="#ffffff" opacity={0.05} bottom="-18%" right="-6%" rotate="-6deg" />
    <div class="container container--820 pad-xl center">
      <h2 class="h2 h2--on-dark h2--cta">Ready to stop guessing and start knowing?</h2>
      <p class="cta-lead">The first conversation is free and there is no obligation. Tell Craig where you are and what you need. If you're not quite sure what you need yet, that's fine. You'll work it out together.</p>
      <div class="cta-actions">
        <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
        <a href={site.phoneOfficeHref} class="btn btn--outline">Call {site.phoneOffice}</a>
      </div>
      <p class="cta-area">Serving businesses across Yorkshire.</p>
    </div>
  </section>

  <Faq items={faqs} seamFill="#ffffff" seamVariant="up" />
</Base>

<style>
  /* No max-width cap: the 1200px container bounds it on desktop (2 lines), and the
     clamp floor in global.css keeps it within 3 lines on a phone. A ch-cap here
     forced over-narrow wrapping on mobile. */
  .hero-strip {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .22em;
    font-size: 12.5px;
    color: var(--sas-gold);
  }

  /* Standout hero line: fixed fee + unlimited support (client priority). */
  .hero-note {
    margin: 22px 0 0;
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.55;
    font-weight: 600;
    color: var(--sas-gold);
  }

  /* Section backgrounds */
  .band-brand { position: relative; overflow: hidden; background: var(--surface-brand-gradient); color: var(--text-on-dark); }
  .band-brand::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 70% at 50% 10%, rgba(212, 175, 55, .12), transparent 70%);
  }
  .band-brand > .container { position: relative; z-index: 1; }
  .band-subtle { background: var(--sas-gray-05); }
  .band-lilac { background: var(--sas-purple-05); }

  /* Padding helpers */
  .pad-lg { padding-block: var(--space-9); }
  .pad-md { padding-block: 96px; }
  .pad-xl { padding-block: 112px; }
  .mt-18 { margin-top: 18px; }
  .mt-28 { margin-top: 28px; }
  .mt-32 { margin-top: 32px; }
  .mt-36 { margin-top: 36px; }
  .mt-44 { margin-top: 44px; }
  .center { text-align: center; }

  /* Container widths */
  .container--880 { max-width: calc(880px + 2 * var(--section-x)); }
  .container--820 { max-width: calc(820px + 2 * var(--section-x)); }
  .container--800 { max-width: calc(800px + 2 * var(--section-x)); }
  .container--1040 { max-width: calc(1040px + 2 * var(--section-x)); }

  /* Two-column layout */
  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; }
  .two-col--center { align-items: center; }
  .two-col--start { align-items: start; }

  /* Body copy */
  .body { font-size: 16.5px; line-height: 1.6; color: var(--sas-ink); max-width: 62ch; }
  .body--strong { font-weight: 600; color: var(--sas-purple-deep); }

  /* Headings size variants */
  .h2--md { font-size: clamp(24px, 2.6vw, 34px); line-height: 1.18; }
  .h2--md2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.14; }
  .h2--md3 { font-size: clamp(24px, 2.8vw, 34px); line-height: 1.16; max-width: 24ch; }
  .h2--sm { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.22; }
  .h2--sm2 { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.16; }
  .h2--lg { font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; }
  .h2--wide { font-size: clamp(28px, 3vw, 40px); line-height: 1.12; }
  .h2--cta { font-size: clamp(30px, 4vw, 50px); line-height: 1.1; }

  /* Photos */
  .photo { width: 100%; border-radius: var(--radius-lg); display: block; }
  .photo--cover { height: 100%; max-height: 640px; object-fit: cover; }
  .photo--wide { height: clamp(260px, 32vw, 440px); object-fit: cover; margin-top: 48px; }

  /* Pain list (gold triangles) */
  .pain-list { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .pain-list li { display: flex; gap: 16px; align-items: flex-start; }
  .pain-list span:last-child { font-size: 16.5px; line-height: 1.6; color: var(--sas-ink); }
  .tri {
    flex-shrink: 0; margin-top: 7px; width: 14px; height: 13px;
    background: var(--sas-gold);
    clip-path: polygon(50% 8%, 100% 100%, 0 100%);
  }

  /* "It is not your fault" band */
  .statement {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.12;
    color: var(--sas-white); margin: 0;
  }
  .band-lead { font-size: clamp(18px, 1.8vw, 22px); line-height: 1.6; color: rgba(255, 255, 255, .94); margin: 32px 0 0; }
  .band-sub { font-size: 16.5px; line-height: 1.6; color: rgba(255, 255, 255, .82); margin: 24px 0 0; }
  .gold-divider--wide { width: 48px; margin: 48px 0; }
  .band-punch {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.25;
    color: var(--sas-gold); margin: 0; max-width: 26ch;
  }

  /* Pull-quote rule */
  .pull-quote {
    font-size: 19px; line-height: 1.55; font-weight: 600; color: var(--sas-purple-deep);
    border-top: 2px solid var(--sas-gold); padding-top: 24px; margin: 32px 0 0; max-width: 30ch;
  }

  /* Stats row */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 28px; margin-top: 40px; }
  .stat { border-top: 2px solid var(--sas-gold); padding-top: 16px; }
  .stat-fig { font-family: var(--font-heading); font-weight: 700; font-size: 26px; color: var(--sas-purple-deep); margin: 0; }
