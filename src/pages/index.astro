---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SoftwareStrip from '../components/SoftwareStrip.astro';
import CurveSeam from '../components/CurveSeam.astro';
import BrandMark from '../components/BrandMark.astro';
import Faq from '../components/Faq.astro';
import type { FaqItem } from '../components/Faq.astro';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { siteUrl } from '../data/site';

import theQuietWorry from '../assets/images/the-quiet-worry.png';
import independentYorkshire from '../assets/images/independent-yorkshire-business.png';
import theAdvisoryMoment from '../assets/images/the-advisory-moment.png';
import craig from '../assets/images/craig-normington.webp';

// SEO metadata to playbook §4 (design meta was not client-approved). Homepage title
// omits the brand — Google auto-appends the site name for homepage results.
const title = 'Small Business Accountant in Penistone & Yorkshire';
const description = 'Bookkeeping, VAT, payroll, accounts and tax for small businesses across Yorkshire. A proactive accountant who shows up all year. Book a free chat.';

const showTestimonials = true;

const faqs: FaqItem[] = [
  { q: 'What does a bookkeeper actually do?', a: 'A bookkeeper records and categorises all your business transactions - income, expenses, bank movements - on a regular basis. They reconcile your bank accounts, prepare VAT returns, keep your records compliant, and ensure your figures are accurate and up to date. Unlike a year-end accountant who looks back once a year, a bookkeeper keeps your finances current throughout the year.' },
  { q: "What's the difference between a bookkeeper and an accountant?", a: 'A bookkeeper handles the day-to-day maintenance of your financial records - categorising transactions, reconciling accounts, filing VAT returns, and keeping everything current. An accountant typically works at a higher level: preparing statutory year-end accounts, filing corporation tax or self-assessment returns, providing strategic financial advice, and handling HMRC compliance. Many businesses need both; some firms provide both services under one roof.' },
  { q: 'How do I know if my business is actually profitable?', a: "If you don't have up-to-date management accounts, you genuinely don't know. Turnover doesn't tell you profitability - you need accurate income and expenditure figures, broken down clearly, to understand your real margins. A bookkeeper producing monthly or quarterly management accounts will give you that picture on an ongoing basis." },
  { q: 'What makes Smart Accounting Solutions different from other accountants?', a: 'The primary difference is personal involvement and continuity. You will always deal with the same bookkeeper who knows your business, and Craig is always directly accessible - not a call centre, not a form, not a three-day wait. Smart Accounting Solutions also places a strong emphasis on regular face-to-face meetings, management accounts, and business understanding - not just compliance-led year-end work.' },
  { q: 'How do I get started with Smart Accounting Solutions?', a: 'The first step is a free, no-obligation conversation with Craig. Contact the team by phone (07393 635760), email (hello@smartaccountingsolutions.co.uk), or via the website contact form. Craig will listen to where you are, ask the right questions, and be straightforward about whether and how he can help - no hard sell, no fixed agenda.' },
  { q: 'My accountant only contacts me once a year at year end. Is that normal?', a: "It's common for traditional accountants, but it's not good enough for most small businesses. Annual accounts are filed months after the year ends and reflect decisions made 18 months ago. You need financial information while it's still useful - which means monthly or quarterly reporting, not an annual review. If your accountant only engages at year end, the value they're adding is largely compliance, not commercial support." },
  { q: "I'm not sure I can afford a bookkeeper right now.", a: 'The question worth asking is whether you can afford not to have one. Missed tax reliefs, HMRC penalties, incorrect VAT coding, and the time you spend on financial admin all have a cost. A bookkeeper typically pays for themselves - and then some - through the time you save and the tax savings they identify. A free initial conversation with Craig will give you a clear picture of what the cost actually looks like for your specific business.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteUrl}/#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={title} description={description} active="home" schema={[faqSchema]}>
  <Hero size="home">
    <h1 class="hero-h1 hero-h1--home home-h1">You run the business. We handle the numbers.</h1>
    <p class="hero-lead">
      Smart Accounting Solutions handles your bookkeeping, VAT, accounts, payroll and tax,
      then sits down with you to make sense of the numbers. You get a clear picture of where
      your business stands and have someone alongside you when decisions need to be made.
    </p>
    <div class="hero-actions">
      <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
      <a href={site.phoneMobileHref} class="btn btn--outline">Call 07393 635760</a>
    </div>
    <p slot="band" class="hero-strip">Bookkeeping&nbsp;&nbsp;·&nbsp;&nbsp;VAT&nbsp;&nbsp;·&nbsp;&nbsp;Payroll&nbsp;&nbsp;·&nbsp;&nbsp;Accounts&nbsp;&nbsp;·&nbsp;&nbsp;Tax</p>
  </Hero>

  <SoftwareStrip />

  <!-- Sound familiar? -->
  <section aria-label="Sound familiar">
    <div class="container two-col two-col--start pad-lg">
      <div>
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="h2 h2--md">Running a business is hard enough without feeling like you're doing it alone.</h2>
        <p class="body mt-28">Most small business owners started out to do one thing well. At some point, the admin, the tax obligations and the financial uncertainty crept in alongside it. Now there is always something nagging in the background.</p>
        <p class="body body--strong mt-32">Does this sound like you?</p>
        <ul class="pain-list">
          <li><span class="tri" aria-hidden="true"></span><span>I am never quite sure where I stand with the numbers</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>I do not have anyone I can lean on to talk through plans and growth</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>It is hard to raise concerns with peers or staff for fear of how it will look</span></li>
          <li><span class="tri" aria-hidden="true"></span><span>The administration burden often feels overwhelming and pulls me away from doing what I am best at</span></li>
        </ul>
      </div>
      <Image src={theQuietWorry} alt="A business owner at a workshop desk reading paperwork with a calculator and laptop nearby" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 560px" class="photo photo--cover" />
    </div>
  </section>

  <!-- It is not your fault -->
  <section aria-label="It is not your fault" class="band-brand">
    <CurveSeam fill="#ffffff" />
    <BrandMark size="min(64vw, 640px)" color="#ffffff" opacity={0.05} top="4%" right="-8%" rotate="-6deg" />
    <div class="container container--880 pad-lg">
      <p class="statement">It is not your fault.</p>
      <p class="band-lead">You did not go into business to become an expert in bookkeeping, tax codes and quarterly filings. But most accountants are not set up to help with any of this either. They hand you a set of numbers that are already out of date and tell you what you should have done differently. That is not advice. That is history.</p>
      <p class="band-sub">There is also the question of rising costs. The last five years have changed what it costs to run a business, and for many owners that has eaten directly into their margins. The sooner you have a clear picture of where the pressure is coming from, the sooner you can do something about it.</p>
      <hr class="gold-divider gold-divider--wide" />
      <p class="band-punch">You deserve better than an accountant who only shows up once a year.</p>
      <a href={site.bookingUrl} class="btn btn--gold mt-44">Book a free chat</a>
    </div>
  </section>

  <!-- A different kind of service -->
  <section aria-label="A different kind of service">
    <CurveSeam fill="#ffffff" variant="up" />
    <div class="container two-col two-col--center pad-lg">
      <Image src={independentYorkshire} alt="An independent shop owner handing a customer their order across the counter" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 560px" class="photo photo--cover order-first" />
      <div>
        <p class="eyebrow">A different kind of service</p>
        <h2 class="h2 h2--sm">We do not just process your numbers. We help you understand them, throughout the year, when it still matters.</h2>
        <p class="body mt-28">Smart Accounting Solutions was built for the businesses that traditional accountants overlook. The sole traders. The small limited companies. The landlords navigating Making Tax Digital. The owner who has a part-time bookkeeper and is not sure they are getting everything they could from them.</p>
        <p class="body mt-18">We handle everything from the basics up: bookkeeping, VAT returns, payroll, management accounts, year-end accounts and tax returns. And then we sit down with you, go through the figures, and tell you what they mean for your business right now, not in 18 months' time when the opportunity to act has passed.</p>
        <p class="body mt-18">If you already have a part-time bookkeeper, we can work alongside them too. We will train them, support them and make sure you are actually getting a return from the time they spend.</p>
        <p class="pull-quote">One phone call, one WhatsApp message. You will always get through to someone who knows you.</p>
      </div>
    </div>
  </section>

  <!-- Meet Craig -->
  <section aria-label="Meet Craig" class="band-subtle">
    <CurveSeam fill="#ffffff" />
    <div class="container two-col two-col--center pad-lg">
      <div>
        <p class="eyebrow">Who you'll be working with</p>
        <h2 class="h2 h2--lg">Meet Craig</h2>
        <p class="body mt-28">My name is Craig Normington. I have over 25 years of experience working directly with small businesses across Yorkshire and beyond.</p>
        <p class="body mt-18">I set up Smart Accounting Solutions because I kept meeting business owners who were not getting the help they needed. Not because their business was too small, but because most accountancy practices are not built to give that kind of attention to smaller clients.</p>
        <p class="body mt-18">Every client I take on, I stay involved with personally. You will not be handed off. You will not go through a call centre. You will deal with me, and with a dedicated bookkeeper who knows your business inside out.</p>
        <div class="stats">
          <div class="stat"><p class="stat-fig">25+</p><p class="stat-label">Years with small businesses</p></div>
          <div class="stat"><p class="stat-fig">One</p><p class="stat-label">Point of contact, always</p></div>
          <div class="stat"><p class="stat-fig">Penistone</p><p class="stat-label">West and North Yorkshire</p></div>
        </div>
        <a href="/about/" class="text-link">Find out more about Craig
          <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true"><path d="M1 6H15M15 6L10.5 1.5M15 6L10.5 10.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
      <Image src={craig} alt="Craig Normington, Director of Smart Accounting Solutions, bookkeeper and accountant serving small businesses across West and North Yorkshire" widths={[400, 600, 720]} sizes="(max-width: 900px) 100vw, 460px" class="img-circle" />
    </div>
  </section>

  <!-- What you get -->
  <section aria-label="What you get">
    <CurveSeam fill="#f7f5f9" />
    <div class="container pad-lg">
      <h2 class="h2 h2--wide">What you get</h2>
      <div class="get-rows">
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>A dedicated bookkeeper.</h3>
          <p class="body">You will always deal with the same person. They will learn how you work, what your business needs, and how to make your life easier. No starting from scratch every month.</p>
        </div>
        <div class="get-row">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>Craig, always on hand</h3>
          <p class="body">Your bookkeeper handles the day-to-day. But Craig is always one call away if something bigger comes up. Finances, HMRC questions, plans for the future, whatever it is, just ask.</p>
        </div>
        <div class="get-row get-row--last">
          <h3 class="get-h3"><span class="sq" aria-hidden="true"></span>Real meetings, not just reports</h3>
          <p class="body">We believe in sitting down together. Whether that is at your place, ours, or on a Zoom or Teams call, we go through the numbers and make sure you actually understand them and know what to do with them. That is how good decisions get made.</p>
        </div>
      </div>
      <Image src={theAdvisoryMoment} alt="Craig going through a set of figures with a client at a desk" widths={[600, 900, 1200]} sizes="(max-width: 1200px) 100vw, 1152px" class="photo photo--wide" />
    </div>
  </section>

  <!-- MTD for Income Tax -->
  <section aria-label="MTD for Income Tax" class="band-lilac">
    <CurveSeam fill="#ffffff" />
    <div class="container two-col two-col--start pad-lg">
      <div>
        <p class="eyebrow">MTD for Income Tax is here.</p>
        <h2 class="h2 h2--md2">Do you know what to do next?</h2>
        <p class="body mt-28">As of April 2026, self-employed businesses and landlords earning over £50,000 must keep digital records and submit quarterly updates to HMRC under Making Tax Digital for Income Tax (MTD for ITSA).</p>
        <p class="body mt-18">By now most people have had the letter. What many do not yet know is exactly what they have to do, or what happens if their quarterly submission goes wrong.</p>
        <p class="body mt-18">If your accountant has not walked you through the process in detail, that is a problem worth sorting. We will get you on the right software, set everything up correctly, and make sure your submissions are filed accurately and on time.</p>
        <p class="body mt-18">And if your turnover is currently below £50,000, do not wait. The threshold drops to £30,000 in April 2027 and £20,000 in April 2028. Getting set up properly now is far easier than scrambling later.</p>
        <a href={site.bookingUrl} class="btn btn--purple btn--sm mt-36">Talk to Craig about MTD for ITSA</a>
      </div>
      <div class="mtd-card">
        <p class="mtd-card-label">The MTD timeline</p>
        <ol class="timeline">
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot tl-dot--filled"></span><span class="tl-line"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2026</p>
              <p class="tl-fig">Over £50,000</p>
              <p class="tl-note">Digital records and quarterly HMRC updates are now mandatory. This is already in force.</p>
            </div>
          </li>
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot"></span><span class="tl-line"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2027</p>
              <p class="tl-fig">Over £30,000</p>
              <p class="tl-note">The threshold drops. Many more sole traders and landlords come into scope.</p>
            </div>
          </li>
          <li class="tl-item">
            <div class="tl-marker"><span class="tl-dot"></span></div>
            <div class="tl-body">
              <p class="tl-date">April 2028</p>
              <p class="tl-fig">Over £20,000</p>
              <p class="tl-note">The threshold drops again. Getting set up early means less pressure when yours arrives.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Who this is for -->
  <section aria-label="Who this is for">
    <CurveSeam fill="#f4eff9" />
    <div class="container container--1040 pad-lg">
      <p class="eyebrow">Who this is for</p>
      <h2 class="h2 h2--md3">You might be exactly who we work best with.</h2>
      <p class="body body--strong mt-28">We work with:</p>
      <ul class="check-list">
        {[
          'Sole traders and landlords getting to grips with MTD for ITSA',
          'Small limited companies looking for proper financial oversight',
          'Business owners who want more than a once-a-year tax conversation',
          'Anyone who has outgrown their current bookkeeping solution',
          'New businesses that want to get set up properly from day one',
          'Anyone who feels they are not getting the help they need from their current accountant',
        ].map((t) => (
          <li>
            <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><circle cx="11" cy="11" r="11" fill="var(--sas-gold)"></circle><path d="M6.5 11.5L9.5 14.5L15.5 8" stroke="#36184f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"></path></svg>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      <div class="who-cta">
        <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
        <p class="body who-cta-note">If you want an accountant who is actually going to get involved in your business, we should talk.</p>
      </div>
    </div>
  </section>

  {showTestimonials && (
    <section aria-label="What clients say" class="band-subtle">
      <CurveSeam fill="#ffffff" />
      <div class="container container--800 pad-md center">
        <h2 class="h2 h2--sm2">What clients say</h2>
        <div class="stars" aria-label="Five stars">
          {[0, 1, 2, 3, 4].map(() => (
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.8L10 14.8l-5.3 2.8 1.1-5.8L1.5 7.7l5.9-.8Z" fill="var(--sas-gold)"></path></svg>
          ))}
        </div>
        <blockquote class="quote">
          <p class="quote-text">"Before Craig, I had no idea how my business was actually performing. Now I come out of every meeting with a clear picture and a list of things to go and do."</p>
          <footer class="quote-cite">Client name, business type, location</footer>
        </blockquote>
      </div>
    </section>
  )}

  <!-- Ready to start -->
  <section aria-label="Ready to start" class="band-brand">
    <CurveSeam fill="#f7f5f9" />
    <BrandMark size="min(60vw, 620px)" color="#ffffff" opacity={0.05} bottom="-18%" right="-6%" rotate="-6deg" />
    <div class="container container--820 pad-xl center">
      <h2 class="h2 h2--on-dark h2--cta">Ready to stop guessing and start knowing?</h2>
      <p class="cta-lead">The first conversation is free and there is no obligation. Tell Craig where you are and what you need. If he can help, he will. If he cannot, he will tell you.</p>
      <div class="cta-actions">
        <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
        <a href={site.phoneMobileHref} class="btn btn--outline">Call 07393 635760</a>
      </div>
      <p class="cta-area">Based in Penistone. Serving businesses across West and North Yorkshire.</p>
    </div>
  </section>

  <Faq items={faqs} seamFill="#ffffff" seamVariant="up" />
</Base>

<style>
  /* No max-width cap: the 1200px container bounds it on desktop (2 lines), and the
     clamp floor in global.css keeps it within 3 lines on a phone. A ch-cap here
     forced over-narrow wrapping on mobile. */
  .hero-strip {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .22em;
    font-size: 12.5px;
    color: var(--sas-gold);
  }

  /* Section backgrounds */
  .band-brand { position: relative; overflow: hidden; background: var(--surface-brand-gradient); color: var(--text-on-dark); }
  .band-brand::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 70% at 50% 10%, rgba(212, 175, 55, .12), transparent 70%);
  }
  .band-brand > .container { position: relative; z-index: 1; }
  .band-subtle { background: var(--sas-gray-05); }
  .band-lilac { background: var(--sas-purple-05); }

  /* Padding helpers */
  .pad-lg { padding-block: var(--space-9); }
  .pad-md { padding-block: 96px; }
  .pad-xl { padding-block: 112px; }
  .mt-18 { margin-top: 18px; }
  .mt-28 { margin-top: 28px; }
  .mt-32 { margin-top: 32px; }
  .mt-36 { margin-top: 36px; }
  .mt-44 { margin-top: 44px; }
  .center { text-align: center; }

  /* Container widths */
  .container--880 { max-width: calc(880px + 2 * var(--section-x)); }
  .container--820 { max-width: calc(820px + 2 * var(--section-x)); }
  .container--800 { max-width: calc(800px + 2 * var(--section-x)); }
  .container--1040 { max-width: calc(1040px + 2 * var(--section-x)); }

  /* Two-column layout */
  .two-col { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 64px; }
  .two-col--center { align-items: center; }
  .two-col--start { align-items: start; }

  /* Body copy */
  .body { font-size: 16.5px; line-height: 1.6; color: var(--sas-ink); max-width: 62ch; }
  .body--strong { font-weight: 600; color: var(--sas-purple-deep); }

  /* Headings size variants */
  .h2--md { font-size: clamp(24px, 2.6vw, 34px); line-height: 1.18; }
  .h2--md2 { font-size: clamp(26px, 3vw, 38px); line-height: 1.14; }
  .h2--md3 { font-size: clamp(24px, 2.8vw, 34px); line-height: 1.16; max-width: 24ch; }
  .h2--sm { font-size: clamp(22px, 2.4vw, 30px); line-height: 1.22; }
  .h2--sm2 { font-size: clamp(24px, 2.6vw, 32px); line-height: 1.16; }
  .h2--lg { font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; }
  .h2--wide { font-size: clamp(28px, 3vw, 40px); line-height: 1.12; }
  .h2--cta { font-size: clamp(30px, 4vw, 50px); line-height: 1.1; }

  /* Photos */
  .photo { width: 100%; border-radius: var(--radius-lg); display: block; }
  .photo--cover { height: 100%; max-height: 640px; object-fit: cover; }
  .photo--wide { height: clamp(260px, 32vw, 440px); object-fit: cover; margin-top: 48px; }

  /* Pain list (gold triangles) */
  .pain-list { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .pain-list li { display: flex; gap: 16px; align-items: flex-start; }
  .pain-list span:last-child { font-size: 16.5px; line-height: 1.6; color: var(--sas-ink); }
  .tri {
    flex-shrink: 0; margin-top: 7px; width: 14px; height: 13px;
    background: var(--sas-gold);
    clip-path: polygon(50% 8%, 100% 100%, 0 100%);
  }

  /* "It is not your fault" band */
  .statement {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.12;
    color: var(--sas-white); margin: 0;
  }
  .band-lead { font-size: clamp(18px, 1.8vw, 22px); line-height: 1.6; color: rgba(255, 255, 255, .94); margin: 32px 0 0; }
  .band-sub { font-size: 16.5px; line-height: 1.6; color: rgba(255, 255, 255, .82); margin: 24px 0 0; }
  .gold-divider--wide { width: 48px; margin: 48px 0; }
  .band-punch {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: .04em; font-size: clamp(20px, 2.2vw, 28px); line-height: 1.25;
    color: var(--sas-gold); margin: 0; max-width: 26ch;
  }

  /* Pull-quote rule */
  .pull-quote {
    font-size: 19px; line-height: 1.55; font-weight: 600; color: var(--sas-purple-deep);
    border-top: 2px solid var(--sas-gold); padding-top: 24px; margin: 32px 0 0; max-width: 30ch;
  }

  /* Stats row */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 28px; margin-top: 40px; }
  .stat { border-top: 2px solid var(--sas-gold); padding-top: 16px; }
  .stat-fig { font-family: var(--font-heading); font-weight: 700; font-size: 26px; color: var(--sas-purple-deep); margin: 0; }
  .stat-label { font-size: 13px; color: var(--sas-gray-70); margin: 4px 0 0; }

  /* Text link with arrow */
  .text-link {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: var(--tracking-button); font-size: 13.5px; color: var(--sas-purple);
    text-decoration: none; margin-top: 36px;
  }
  .text-link:hover { color: var(--sas-purple-70); }

  /* What you get rows */
  .get-rows { margin-top: 48px; display: flex; flex-direction: column; }
  .get-row {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px 48px;
    padding: 32px 0; align-items: start;
    border-top: 1px solid transparent;
    border-image: linear-gradient(90deg, var(--sas-purple-15), rgba(201, 180, 224, .12)) 1;
  }
  .get-row--last { border-bottom: 1px solid transparent; border-image: linear-gradient(90deg, var(--sas-purple-15), rgba(201, 180, 224, .12)) 1; }
  .get-h3 {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
