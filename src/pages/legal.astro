---
import Base from '../layouts/Base.astro';
const title = 'Terms & Legal | Smart Accounting Solutions';
const description = 'Terms and conditions for Smart Accounting Solutions Limited.';
---
<Base title={title} description={description} noindex={true}>
  <section class="section">
    <div class="container container--narrow">
      <h1 class="h2">Terms &amp; Legal</h1>
      <hr class="gold-divider" />
      <p class="lead">This page is awaiting approved terms and conditions copy from the client.</p>
    </div>
  </section>
</Base>
