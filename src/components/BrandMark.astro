---
/* Signature motif — the SAS symbol used as a large, faint decorative watermark.
   Single-path monogram (real brand asset), recoloured via `color`. Decorative only
   (aria-hidden). Parent must be position:relative + overflow:hidden. */
interface Props {
  size?: string;      // e.g. '540px'
  color?: string;     // e.g. '#ffffff' or 'var(--sas-purple)'
  opacity?: number;   // 0–1
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  rotate?: string;    // e.g. '-8deg'
  class?: string;
}
const {
  size = '540px',
  color = '#ffffff',
  opacity = 0.06,
  top, right, bottom, left,
  rotate = '0deg',
  class: className = '',
} = Astro.props;

const style = [
  `--mark-size:${size}`,
  `--mark-color:${color}`,
  `--mark-opacity:${opacity}`,
  `--mark-rotate:${rotate}`,
  top != null ? `top:${top}` : '',
  right != null ? `right:${right}` : '',
  bottom != null ? `bottom:${bottom}` : '',
  left != null ? `left:${left}` : '',
].filter(Boolean).join(';');
---
<svg
  class:list={['brand-mark', className]}
  style={style}
  viewBox="-5 -5 98.4 92.3"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
