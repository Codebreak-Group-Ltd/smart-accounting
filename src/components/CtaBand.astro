---
/* Closing CTA band — deep-purple gradient, centred, two buttons + service-area line.
   Reused across About, Services, Contact (Home has its own inline variant). */
import CurveSeam from './CurveSeam.astro';
import BrandMark from './BrandMark.astro';
import { site } from '../data/site';

interface Props {
  heading: string;
  lead: string;
  seamFill: string;
  leadWidth?: string; // ch cap for the lead paragraph
  areaLine?: string;
}
const {
  heading,
  lead,
  seamFill,
  leadWidth = '54ch',
  areaLine = 'Based in Penistone. Serving businesses across West and North Yorkshire.',
} = Astro.props;
---
<section aria-label="Call to action" class="cta-band">
  <CurveSeam fill={seamFill} />
  <BrandMark size="min(60vw, 620px)" color="#ffffff" opacity={0.05} bottom="-16%" right="-6%" rotate="-6deg" />
  <div class="container cta-inner">
    <h2 class="h2 h2--on-dark cta-heading">{heading}</h2>
    <p class="cta-lead" style={`max-width:${leadWidth}`}>{lead}</p>
    <div class="cta-actions">
      <a href={site.bookingUrl} class="btn btn--gold">Book a free chat</a>
      <a href={site.phoneMobileHref} class="btn btn--outline">Call 07393 635760</a>
    </div>
    <p class="cta-area">{areaLine}</p>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; background: var(--surface-brand-gradient); color: var(--text-on-dark); }
  /* Subtle gold glow adds depth to the flat gradient without reading as decoration. */
  .cta-band::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(60% 80% at 50% 12%, rgba(212, 175, 55, .14), transparent 70%);
  }
  .cta-inner { position: relative; z-index: 1; max-width: calc(820px + 2 * var(--section-x)); padding-block: 112px; text-align: center; }
  .cta-heading { font-size: clamp(28px, 3.8vw, 48px); line-height: 1.1; }
  .cta-lead { font-size: 18px; line-height: 1.6; color: rgba(255, 255, 255, .9); margin: 28px auto 0; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 44px; }
  .cta-area {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    letter-spacing: var(--tracking-wide); font-size: 12px; color: var(--sas-gold); margin: 56px 0 0;
  }
</style>
