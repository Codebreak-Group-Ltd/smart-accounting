# Copy to .env for local overrides, or set these in the Netlify UI.
# NOTHING here is committed with real values — .env is gitignored.

# Production domain — drives canonicals, og:url and the sitemap.
# Leave unset for previews (falls back to the placeholder in astro.config.mjs).
SITE_URL=https://www.smartaccountingsolutions.co.uk

# Indexing switch. Preview default is OFF (noindex + robots Disallow: /).
# Set to "true" in Netlify ONLY at launch.
PUBLIC_INDEXABLE=false

# Preview password gate (set in Netlify, keep secret; unset = gate OFF at launch).
# PREVIEW_USER=client
# PREVIEW_PASSWORD=choose-a-strong-shared-password
